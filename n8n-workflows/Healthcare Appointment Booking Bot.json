    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const output = $input.item.json.output || $input.item.json.text || '';\n\nconst nameMatch = output.match(/Name:\\s*(.+)/);\nconst ageMatch = output.match(/Age:\\s*(.+)/);\nconst phoneMatch = output.match(/Phone:\\s*(.+)/);\nconst departmentMatch = output.match(/Department:\\s*(.+)/);\nconst dateMatch = output.match(/Date:\\s*(.+)/);\nconst timeMatch = output.match(/Time:\\s*(.+)/);\n\nreturn {\n  name: nameMatch ? nameMatch[1].trim() : '',\n  age: ageMatch ? ageMatch[1].trim() : '',\n  phone: phoneMatch ? phoneMatch[1].trim() : '',\n  department: departmentMatch ? departmentMatch[1].trim() : '',\n  date: dateMatch ? dateMatch[1].trim() : '',\n  time: timeMatch ? timeMatch[1].trim() : '',\n  output: output\n};"
      },
